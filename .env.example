# =====================================================================
# PIN-SELES (CNA) - Backend - Variables de Entorno
# =====================================================================
# Copia este fichero como ".env" y rellena los valores reales.
# NUNCA subas el fichero .env al repositorio.
# =====================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- Base de Datos MongoDB ---
# Local:   mongodb://localhost:27017/pinseles
# Atlas:   mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/pinseles
MONGO_URI=mongodb://localhost:27017/pinseles

# --- Seguridad / JWT ---
# IMPORTANTE: En producción usa un secreto largo y aleatorio.
# Ejemplo para generar uno: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dfb3932783dc439c3f60783a042dabb3c3507b4e68d84fd457d01391f95cc313524b97054cbe890bcf8a89979e45a3e622b7824083c64be04d7584f772dadd31
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# --- CORS ---
# Orígenes permitidos separados por coma. "*" solo para desarrollo.
CORS_ORIGIN=*

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Logging ---
LOG_LEVEL=dev
